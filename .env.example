# Gere uma chave: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
DATABASE_URL=sqlite:///database.db
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALLOW_REGISTRATION=false
CORS_ORIGINS=[]
API_URL=http://127.0.0.1:8000
# API acessível pelo navegador. Vazio: usa o host da interface na porta 8000.
PUBLIC_API_URL=
BROWSER_ORIGINS=["http://localhost:8501","http://127.0.0.1:8501"]
SESSION_HOURS=12
# true em HTTPS; false somente no desenvolvimento/ensaio HTTP.
SESSION_COOKIE_SECURE=false
